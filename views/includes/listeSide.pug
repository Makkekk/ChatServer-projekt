include header.pug


//overskrift uden for grid
h1 Velkommen, #{username}
img.top-billede(src="/assets/images/jamalhalal.jpg", alt="Velkommen Billede")


.listeSide-grid
  div.card.main-card 
    

    div.card-header
      h2 Dine chats
      
      form(id="createChatForm" class="inline-create-form")
        input(type='text', name='chatName', placeholder='Navn på ny chat', required)
        button(type='submit') + Opret

    ul#chatList
      li Indlæser chats...

  if niveau === 3
    div.card
      div.card-header
        h2 Admin Panel
      ul#userList
        li Indlæser brugere...

script. 
  const currentUser = "#{username}";
  const userNiveau = #{niveau};

script(src='/assets/javaScript/deleteScript.js')
script(src='/assets/javaScript/load.js')
script(src='/assets/javaScript/create.js')