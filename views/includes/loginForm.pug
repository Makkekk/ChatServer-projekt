// Hoved-containeren centrerer indholdet
div.center-page 
    
    // Card laver et kort layout til login-formularen
    
    div.card(style="width: 100%; max-width: 400px;")

        img.login-logo(src="/assets/images/logo.png", alt="Logo")
        h1 Log ind på din konto

        //holder form fordi google leder efter form og det er en service. Vi anullere bare requestet inde i javascript
        form(id="loginForm") 
            div
                label(for="username") Brugernavn:
                input(type="text" id="username" name="username", placeholder="Indtast dit brugernavn", required)
            
            div(style="margin-top: 10px;")
                label(for="password") Adgangskode:
                input(type="password" id="password" name="password", placeholder="Indtast din adgangskode", required)

            button(type="submit", style="margin-top: 20px; width: 100%") Log ind
            
            p(style="margin-top: 15px; text-align: center;") Har du ikke en konto?
                br
                a(href="/createAccount") Opret bruger her

    p Kreation af Simon, Jamal og Karsten

script(src='/assets/javaScript/login.js')