include header.pug

//.center-page 
//  .card
.page-container 
  .split-card
    .split-card__form-wrapper 
       .login-form
        h1 Opret dig som bruger
        form#loginForm.login-form__form
        .login-form__group
          label(for="username") Brugernavn:
          input(type='text', name='username', placeholder="Indtast dit brugernavn", required)
               
        .login-form__group
         label(for="password") Adgangskode:
         input(type='password', name='password', placeholder="Indtast din adgangskode", required)

         button.login-form__button(type='submit') Opret bruger

    .split-card__image-wrapper
      img.split-card__image(src="/assets/images/circleOfLife.png", alt="Decorative image")

script(src='/assets/javaScript/create.js')