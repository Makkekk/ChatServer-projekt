include header.pug

// Vi wrapper indholdet i main, så det passer med body-griddet (auto 1fr)
main
  div.chat-page
    // 1. Øverste kasse (Header i chatten)
    div(style="padding: 20px; border-bottom: 1px solid #ddd;")
      h1 #{chatName || 'Chat'}
      a(href="/" style="font-size: 0.9em; color: #666;") ← Tilbage til oversigt

    // 2. Midterste kasse (Beskederne - denne vil nu fylde ud!)
    div#messages

    // 3. Nederste kasse (Input feltet)
    div.chat-input-area
      textarea(id='messageText', placeholder='Skriv en besked...' style="resize: none; height: 50px;")
      button(type='button', onclick=`sendMessage('${chatId}')`) Send

script.
  const currentChatId = "#{chatId}";
  const currentUser = "#{username}";
  const userLevel = #{level};

script(src='/assets/javaScript/load.js')
script(src='/assets/javaScript/sendScript.js')
script(src='/assets/javaScript/deleteScript.js')