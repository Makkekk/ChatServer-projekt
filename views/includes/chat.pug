include header.pug

h1 Chat: #{chatName}
p
  a(href='/createChat') ← Tilbage til chats

h2 Beskeder
div#messages
  if messages.length > 0
    each message in messages
      p
        strong #{message.sender}: 
        | #{message.text}
        br
        small #{message.date}
  else
    p Ingen beskeder endnu.

h2 Send besked
textarea(id='messageText', placeholder='Skriv din besked...')
br
button(type='button', onclick=`sendMessage('${chatId}')`) Send

script(src='/assets/javascript/sendScript.js')
