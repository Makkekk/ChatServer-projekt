doctype html
html(lang="da")
  head
    meta(charset="UTF-8")
    title= title
    link(rel="stylesheet", href="/assets/css/style.css")
  body

    header
      div.header-left
        img.logo(src="/assets/images/logo.png", alt="Chat Logo") 
        a(href="/") Hjem

      if username
        div.header-right
          p.badge (Niveau #{niveau})
          p #{username}
          a.btn-logout(href="/logout") Log ud